<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout charset="UTF-8" pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%t] %c{1} - %msg%n%throwable"/>
        </Console>
        <RollingFile name="File" fileName="${sys:catalina.base}/logs/product-management.log"
                     filePattern="${sys:catalina.base}/logs/product-management-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout charset="UTF-8" pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%t] %c{1} - %msg%n%throwable"/>
            <Policies><TimeBasedTriggeringPolicy/><SizeBasedTriggeringPolicy size="10 MB"/></Policies>
            <DefaultRolloverStrategy max="7"/>
        </RollingFile>
    </Appenders>
    <Loggers>
        <Logger name="com.example.product" level="info"/>
        <Logger name="org.springframework" level="warn"/>
        <Root level="info"><AppenderRef ref="Console"/><AppenderRef ref="File"/></Root>
    </Loggers>
</Configuration>
